generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum Kingdom {
  PLANT
  ANIMAL
  FUNGI
}

enum LifeCycle {
  ANNUAL
  BIENNIAL
  PERENNIAL
}

enum RecordType {
  CULTIVAR
  BREED
  STRAIN
}

enum RotationGroup {
  ROOT
  ALLIUM
  FRUIT
  LEGUME
  LEAF
}

enum ProductionSystem {
  NURSERY
  MARKET_GARDEN
  FOREST
  LAYERS
  BROILERS
}

enum AreaType {
  BED
  NURSERY_BENCH
  TRACTOR
  FOREST_ROW
  COOP
  PADDOCK
}

enum ConfidenceLevel {
  ESTIMATED
  TESTED
  VALIDATED
}

enum SourceType {
  SUPPLIER
  LITERATURE
  OWN_TRIAL
}

enum FlockType {
  LAYER
  BROILER
}

enum CanopyStratum {
  EMERGENT
  HIGH
  MEDIUM
  LOW
  SHRUB
  GROUND_COVER
  CLIMBER
}

enum SuccessionalStage {
  PLACENTA
  SECONDARY
  CLIMAX
}

enum MaturityBasis {
  FROM_SOWING
  FROM_TRANSPLANT
}

enum Suitability {
  PREFERRED
  POSSIBLE
  AVOID
}

enum AnchorType {
  SEED_DATE
  TARGET_HARVEST
  HATCH_DATE
}

enum SchedulingDirection {
  FORWARD
  BACKWARD
}

enum ActivityType {
  SOW
  GERMINATION_CHECK
  POT_UP
  HARDEN_OFF
  TRANSPLANT
  WATER
  FERTILIZE
  PEST_TREATMENT
  WEED
  PRUNE
  TRELLIS
  MULCH
  HARVEST
  MOVE
  FEED
  COLLECT_EGGS
  MORTALITY
  OBSERVATION
  OTHER
}

enum RelationshipType {
  FINISH_TO_START
}

enum TriggerType {
  TIME
  CONDITION
  OBSERVATION
}

enum BatchStatus {
  PLANNED
  SEEDED
  IN_NURSERY
  READY_TO_TRANSPLANT
  TRANSPLANTED
  GROWING
  HARVESTING
  COMPLETED
  ABANDONED
}

enum PublicStatus {
  PRIVATE
  CANDIDATE
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  RETIRED
}

enum PlacementType {
  SOWN
  PLACED
  TRANSPLANTED
  MOVED
  GRAZED
}

enum ActivityStatus {
  PLANNED
  DONE
  SKIPPED
}

enum ItemType {
  SEED
  FEED
  COMPOST
  CONDITIONER
  AMENDMENT
  PACKAGING
  PRODUCT
  OTHER
}

enum LotStatus {
  AVAILABLE
  QUARANTINED
  EXHAUSTED
}

enum UserRole {
  OWNER
  PLANNER
  FIELD_WORKER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
}

// ---------- Foundation ----------

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  farms Farm[]
  users User[]
}

model Farm {
  id              String   @id @default(cuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  name            String
  timezone        String   @default("Australia/Brisbane")
  climateZone     String?
  latitude        Float?
  longitude       Float?
  defaultAreaUnit String   @default("m2")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  areas             ProductionArea[]
  species           Species[]
  productionMethods ProductionMethod[]
  batches           ProductionBatch[]
  items             Item[]
  products          Product[]
  activities        Activity[]
  customers         Customer[]
  orders            Order[]

  @@index([tenantId])
}

model User {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(FIELD_WORKER)
  passwordHash  String?

  accounts Account[]
  sessions Session[]

  @@index([tenantId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Spatial ----------

model ProductionArea {
  id            String   @id @default(cuid())
  farmId        String
  farm          Farm     @relation(fields: [farmId], references: [id])
  parentAreaId  String?
  parentArea    ProductionArea?  @relation("AreaHierarchy", fields: [parentAreaId], references: [id])
  childAreas    ProductionArea[] @relation("AreaHierarchy")
  areaType      AreaType
  code          String
  name          String
  gridX         Int?
  gridY         Int?
  lengthM       Float?
  widthM        Float?
  areaM2        Float?
  capacity      Int?
  capacityUnit  String?
  soilType      String?
  activeFrom    DateTime?
  activeTo      DateTime?
  publicVisible Boolean  @default(false)
  createdAt     DateTime @default(now())

  batchLocations BatchLocation[]
  activities     Activity[]
  observations   Observation[]
  harvests       Harvest[]

  @@unique([farmId, code])
  @@index([farmId])
  @@index([parentAreaId])
}

// ---------- Biological reference ----------

model Species {
  id             String     @id @default(cuid())
  farmId         String
  farm           Farm       @relation(fields: [farmId], references: [id])
  kingdom        Kingdom
  commonName     String
  scientificName String?
  family         String?
  lifeCycle      LifeCycle?
  nativeStatus   String?
  primaryRole    String?
  description    String?
  active         Boolean    @default(true)

  varieties VarietyBreed[]

  @@unique([farmId, commonName])
  @@index([farmId])
}

model VarietyBreed {
  id                String         @id @default(cuid())
  speciesId         String
  species           Species        @relation(fields: [speciesId], references: [id])
  name              String
  recordType        RecordType     @default(CULTIVAR)
  rotationGroup     RotationGroup?
  openPollinated    Boolean?
  hybrid            Boolean?
  heirloom          Boolean?
  typicalColour     String?
  typicalMatureSize String?
  publicDescription String?
  active            Boolean        @default(true)

  profiles ProductionProfile[]
  batches  ProductionBatch[]
  products Product[]

  @@unique([speciesId, name])
  @@index([speciesId])
}

// ---------- Production knowledge ----------

model ProductionMethod {
  id                    String           @id @default(cuid())
  farmId                String
  farm                  Farm             @relation(fields: [farmId], references: [id])
  name                  String
  productionSystem      ProductionSystem
  internalDescription   String?
  publicDescription     String?
  certificationRelevant Boolean          @default(false)
  active                Boolean          @default(true)

  profiles ProductionProfile[]

  @@unique([farmId, name])
  @@index([farmId])
}

model ProductionProfile {
  id                      String           @id @default(cuid())
  varietyBreedId          String
  varietyBreed            VarietyBreed     @relation(fields: [varietyBreedId], references: [id])
  methodId                String
  method                  ProductionMethod @relation(fields: [methodId], references: [id])
  name                    String
  version                 Int              @default(1)
  effectiveFrom           DateTime?
  effectiveTo             DateTime?
  locationOrClimateZone   String?
  nurseryRequired         Boolean          @default(false)
  targetNurseryDays       Int?
  targetProductionDays    Int?
  targetHarvestStartDays  Int?
  targetHarvestWindowDays Int?
  expectedSurvivalPct     Float?
  expectedYieldValue      Float?
  expectedYieldUnit       String?
  sourceType              SourceType?
  sourceReference         String?
  confidenceLevel         ConfidenceLevel  @default(ESTIMATED)
  approvedBy              String?
  approvedAt              DateTime?
  active                  Boolean          @default(true)

  cropProfile       CropProfile?
  poultryProfile    PoultryProfile?
  treeProfile       TreeProfile?
  seasonRules       SeasonRule[]
  workflowTemplates WorkflowTemplate[]
  batches           ProductionBatch[]
  products          Product[]

  @@unique([varietyBreedId, methodId, version])
  @@index([varietyBreedId])
}

// Plant-specific extension of ProductionProfile. Future NurseryProfile/TreeProfile/
// PoultryProfile extensions attach the same way without touching this table.
model CropProfile {
  id      String            @id @default(cuid())
  profileId String          @unique
  profile ProductionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  daysToGerminationMin     Int?
  daysToGerminationTypical Int?
  daysToGerminationMax     Int?
  germinationRatePct       Float?
  germinationTempMinC      Float?
  germinationTempOptC      Float?
  germinationTempMaxC      Float?
  seedDepthMm              Float?
  seedsPerCell             Int?
  seedsPerMetre            Float?
  recommendedTrayType      String?
  daysInNursery            Int?
  hardeningDays            Int?
  targetTransplantAgeDays  Int?
  plantSpacingMm           Int?
  rowSpacingMm             Int?
  bedWidthMm               Int?
  plantsPerM2              Float?
  trellisRequired          Boolean       @default(false)
  pruningRequired          Boolean       @default(false)
  mulchRecommended         Boolean       @default(false)
  frostSensitivity         String?
  heatSensitivity          String?
  droughtTolerance         String?
  shadeTolerance           String?
  maturityBasis            MaturityBasis @default(FROM_TRANSPLANT)
  daysToFirstHarvest       Int?
  harvestWindowDays        Int?
  harvestFrequencyDays     Int?
  successionFriendly       Boolean       @default(false)
  successionIntervalDays   Int?
}

// Poultry-specific extension of ProductionProfile — same attach pattern as CropProfile.
model PoultryProfile {
  id        String            @id @default(cuid())
  profileId String            @unique
  profile   ProductionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  flockType                         FlockType
  breedName                         String?
  broodingDays                      Int?
  growOutDays                       Int?
  targetStockingDensity             Float?
  targetStockingDensityUnit         String?
  expectedFeedConsumptionPerBirdDay Float?
  expectedEggsPerHenWeek            Float?
  expectedLiveWeightKg              Float?
  targetLayingStartDays             Int?
  targetProcessingAgeDays           Int?
  expectedMortalityPct              Float?
}

// Syntropic/agroforestry-specific extension of ProductionProfile — same attach
// pattern as CropProfile/PoultryProfile.
model TreeProfile {
  id        String            @id @default(cuid())
  profileId String            @unique
  profile   ProductionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  canopyStratum           CanopyStratum
  successionalStage       SuccessionalStage
  matureHeightM           Float?
  matureSpreadM           Float?
  withinRowSpacingM       Float?
  betweenRowSpacingM      Float?
  yearsToFirstYield       Float?
  nitrogenFixer           Boolean           @default(false)
  chopAndDropCandidate    Boolean           @default(false)
  pruningFrequencyMonths  Int?
}

// Season windows as rows, not Jan-Dec columns — supports multiple climate zones
// and activity types without a schema change.
model SeasonRule {
  id                    String            @id @default(cuid())
  profileId             String
  profile               ProductionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  locationOrClimateZone String?
  activityType          ActivityType
  startMonth            Int
  startWeek             Int?
  endMonth              Int
  endWeek               Int?
  suitability           Suitability
  constraintType        String?
  minThreshold          Float?
  maxThreshold          Float?
  notes                 String?

  @@index([profileId])
}

// ---------- Workflow templates ----------

model WorkflowTemplate {
  id                  String              @id @default(cuid())
  profileId           String
  profile             ProductionProfile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name                String
  version             Int                 @default(1)
  anchorType          AnchorType          @default(SEED_DATE)
  schedulingDirection SchedulingDirection @default(FORWARD)
  effectiveFrom       DateTime?
  effectiveTo         DateTime?
  active              Boolean             @default(true)

  taskTemplates WorkflowTaskTemplate[]
  batches       ProductionBatch[]

  @@index([profileId])
}

// Offset days are relative to the workflow's anchor (usually seed date) — see
// WorkflowTemplate.anchorType. TaskDate = Batch.actualStartDate + offsetFromAnchorDays.
model WorkflowTaskTemplate {
  id                        String                @id @default(cuid())
  workflowTemplateId        String
  workflowTemplate          WorkflowTemplate      @relation(fields: [workflowTemplateId], references: [id], onDelete: Cascade)
  taskType                  ActivityType
  taskName                  String
  sequence                  Int
  predecessorTaskTemplateId String?
  predecessorTaskTemplate   WorkflowTaskTemplate?  @relation("TaskDependency", fields: [predecessorTaskTemplateId], references: [id])
  dependentTasks            WorkflowTaskTemplate[] @relation("TaskDependency")
  relationshipType          RelationshipType?
  lagDays                   Int?
  offsetFromAnchorDays      Int?
  durationDays              Int                   @default(1)
  triggerType               TriggerType           @default(TIME)
  triggerRule               String?
  responsibleRole           String?
  standardLabourMinutes     Int?
  publicEligible            Boolean               @default(false)

  @@index([workflowTemplateId])
}

// ---------- Production transactions (the shared spine) ----------

model ProductionBatch {
  id                   String            @id @default(cuid())
  farmId               String
  farm                 Farm              @relation(fields: [farmId], references: [id])
  parentBatchId        String?
  parentBatch          ProductionBatch?  @relation("BatchLineage", fields: [parentBatchId], references: [id])
  childBatches         ProductionBatch[] @relation("BatchLineage")
  batchCode            String
  enterpriseType       ProductionSystem
  varietyBreedId       String
  varietyBreed         VarietyBreed      @relation(fields: [varietyBreedId], references: [id])
  profileId            String?
  profile              ProductionProfile? @relation(fields: [profileId], references: [id])
  profileVersion       Int?
  workflowTemplateId   String?
  workflowTemplate     WorkflowTemplate? @relation(fields: [workflowTemplateId], references: [id])
  plannedStartDate     DateTime?
  actualStartDate      DateTime?
  targetCompletionDate DateTime?
  actualCompletionDate DateTime?
  initialQuantity      Float?
  currentQuantity      Float?
  quantityUnit         String?
  status               BatchStatus       @default(PLANNED)
  publicStatus         PublicStatus      @default(PRIVATE)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  locations    BatchLocation[]
  activities   Activity[]
  observations Observation[]
  harvests     Harvest[]

  @@unique([farmId, batchCode])
  @@index([farmId])
  @@index([varietyBreedId])
}

// Full occupancy history — a batch's nursery-bench time and its bed time are
// both rows here, which is what makes the nursery-to-garden handoff a single
// traceable batch instead of two disconnected records.
model BatchLocation {
  id            String          @id @default(cuid())
  batchId       String
  batch         ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  areaId        String
  area          ProductionArea  @relation(fields: [areaId], references: [id])
  startDateTime DateTime
  endDateTime   DateTime?
  quantity      Float?
  unit          String?
  placementType PlacementType
  activityId    String?
  activity      Activity?       @relation(fields: [activityId], references: [id])
  notes         String?

  @@index([batchId])
  @@index([areaId])
}

// Generalizes the old LifecycleEvent — planned or completed work, for a crop
// planting or a bird batch alike.
model Activity {
  id                  String         @id @default(cuid())
  farmId              String
  farm                Farm           @relation(fields: [farmId], references: [id])
  batchId             String?
  batch               ProductionBatch? @relation(fields: [batchId], references: [id])
  areaId              String?
  area                ProductionArea?  @relation(fields: [areaId], references: [id])
  taskTemplateId      String?
  activityType        ActivityType
  plannedDateTime     DateTime?
  actualStartDateTime DateTime?
  actualEndDateTime   DateTime?
  status              ActivityStatus @default(PLANNED)
  quantity            Float?
  unit                String?
  performedByUserId   String?
  reasonCode          String?
  internalNotes       String?
  publicSummary       String?
  publicStatus        PublicStatus   @default(PRIVATE)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  batchLocations BatchLocation[]
  inputs         ActivityInput[]
  observations   Observation[]

  @@index([farmId])
  @@index([batchId])
  @@index([areaId])
}

// Kept distinct from Activity: "applied 25kg compost" (Activity) vs.
// "leaf colour improved" (Observation).
model Observation {
  id                       String   @id @default(cuid())
  batchId                  String?
  batch                    ProductionBatch? @relation(fields: [batchId], references: [id])
  areaId                   String?
  area                     ProductionArea?  @relation(fields: [areaId], references: [id])
  observationType          String
  observedAt               DateTime @default(now())
  measurementValue         Float?
  unit                     String?
  rating                   String?
  notes                    String?
  correctiveActionRequired Boolean  @default(false)
  correctiveActivityId     String?
  correctiveActivity       Activity? @relation(fields: [correctiveActivityId], references: [id])
  publicEligible           Boolean  @default(false)

  @@index([batchId])
  @@index([areaId])
}

// ---------- Inventory (generalizes InputMaterial/InputApplication) ----------

model Item {
  id               String   @id @default(cuid())
  farmId           String
  farm             Farm     @relation(fields: [farmId], references: [id])
  itemType         ItemType
  code             String
  name             String
  defaultUnit      String
  supplierItemCode String?
  trackByLot       Boolean  @default(true)
  reorderPoint     Float?
  active           Boolean  @default(true)

  lots InventoryLot[]

  @@unique([farmId, code])
  @@index([farmId])
}

model InventoryLot {
  id                 String    @id @default(cuid())
  itemId             String
  item               Item      @relation(fields: [itemId], references: [id])
  lotCode            String
  supplierLotNumber  String?
  purchaseDate       DateTime?
  expiryDate         DateTime?
  quantityReceived   Float
  quantityRemaining  Float
  unit               String
  unitCost           Float?
  storageArea        String?
  germinationTestPct Float?
  status             LotStatus @default(AVAILABLE)

  activityInputs ActivityInput[]

  @@unique([itemId, lotCode])
  @@index([itemId])
}

model ActivityInput {
  id             String       @id @default(cuid())
  activityId     String
  activity       Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  inventoryLotId String
  inventoryLot   InventoryLot @relation(fields: [inventoryLotId], references: [id])
  quantity       Float
  unit           String
  costSnapshot   Float?

  @@index([activityId])
  @@index([inventoryLotId])
}

// ---------- Output (light — no ProductLot until a real store needs mixed products) ----------

model Harvest {
  id                 String       @id @default(cuid())
  batchId            String
  batch              ProductionBatch @relation(fields: [batchId], references: [id])
  harvestLotCode     String
  harvestDateTime    DateTime     @default(now())
  areaId             String?
  area               ProductionArea? @relation(fields: [areaId], references: [id])
  grossQuantity      Float
  marketableQuantity Float?
  secondsQuantity    Float?
  wasteQuantity      Float?
  unit               String
  qualityGrade       String?
  harvestedByUserId  String?
  publicStatus       PublicStatus @default(PRIVATE)

  @@index([batchId])
}

model Product {
  id               String        @id @default(cuid())
  farmId           String
  farm             Farm          @relation(fields: [farmId], references: [id])
  varietyBreedId   String?
  varietyBreed     VarietyBreed? @relation(fields: [varietyBreedId], references: [id])
  profileId        String?
  profile          ProductionProfile? @relation(fields: [profileId], references: [id])
  sku              String
  name             String
  category         String?
  saleUnit         String
  standardPackSize String?
  price            Float?
  publicVisible    Boolean       @default(false)
  primaryMediaUrl  String?
  // null = untracked/unlimited, the default for every existing product so
  // nothing already listed changes behaviour until an admin opts in.
  stockOnHand      Int?
  active           Boolean       @default(true)

  orderItems OrderItem[]

  @@unique([farmId, sku])
  @@index([farmId])
}

// ---------- Commerce (guest checkout, no forced accounts) ----------

model Customer {
  id        String   @id @default(cuid())
  farmId    String
  farm      Farm     @relation(fields: [farmId], references: [id])
  email     String
  name      String
  phone     String?
  createdAt DateTime @default(now())

  orders Order[]

  @@unique([farmId, email])
  @@index([farmId])
}

model Order {
  id                     String      @id @default(cuid())
  farmId                 String
  farm                   Farm        @relation(fields: [farmId], references: [id])
  customerId             String
  customer               Customer    @relation(fields: [customerId], references: [id])
  status                 OrderStatus @default(PENDING)
  subtotal               Float
  total                  Float
  currency               String      @default("aud")
  stripeCheckoutSessionId String?    @unique
  stripePaymentIntentId  String?
  fulfilmentNote         String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  items OrderItem[]

  @@index([farmId])
  @@index([customerId])
}

// productName/unitPrice are snapshotted at order time — never re-derived from
// the live Product row, so a later price change never rewrites history.
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String
  unitPrice   Float
  quantity    Int
  lineTotal   Float

  @@index([orderId])
  @@index([productId])
}
